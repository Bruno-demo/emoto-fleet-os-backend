              "script": {
                "type": "text/javascript",
                "exec": [
                  "const now = new Date();",
                  "const from = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000).toISOString();",
                  "const to = now.toISOString();",
                  "pm.variables.set('dateFrom', from);",
                  "pm.variables.set('dateTo', to);"
                ]
