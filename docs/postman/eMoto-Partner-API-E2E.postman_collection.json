    {
      "name": "4 — Incidents",
      "item": [
        {
          "name": "4.1 — Get resolved incident details",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Incident response shape', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('incidentId');",
                  "    pm.expect(body).to.have.property('fleetId');",
                  "    pm.expect(body).to.have.property('deviceId');",
                  "    pm.expect(body).to.have.property('eventId');",
                  "    pm.expect(body).to.have.property('status');",
                  "    pm.expect(body).to.have.property('createdAt');",
                  "    pm.expect(body).to.have.property('timeline').that.is.an('array');",
                  "});",
                  "",
                  "pm.test('Status is RESOLVED', () => {",
                  "    pm.expect(pm.response.json().status).to.eql('RESOLVED');",
                  "});",
                  "",
                  "pm.test('Timeline events have required fields', () => {",
                  "    const timeline = pm.response.json().timeline;",
                  "    if (timeline.length > 0) {",
                  "        const ev = timeline[0];",
                  "        pm.expect(ev).to.have.property('id');",
                  "        pm.expect(ev).to.have.property('ts');",
                  "        pm.expect(ev).to.have.property('type');",
                  "        pm.expect(ev).to.have.property('severity');",
                  "    }",
                  "});",
                  "",
                  "pm.test('Location precision is reduced (privacy)', () => {",
                  "    const timeline = pm.response.json().timeline;",
                  "    timeline.forEach(ev => {",
                  "        if (ev.metaJson && typeof ev.metaJson === 'object') {",
                  "            if (ev.metaJson.lat !== undefined) {",
                  "                const decimals = ev.metaJson.lat.toString().split('.')[1];",
                  "                pm.expect(decimals ? decimals.length : 0).to.be.at.most(3);",
                  "            }",
                  "        }",
                  "    });",
                  "});"
                ]
              }
            }
