      "name": "3 — Bike Trips",
      "item": [
        {
          "name": "3.1 — List trips for Demo bike (default pagination)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Paginated response shape', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('data').that.is.an('array');",
                  "    pm.expect(body).to.have.property('meta');",
                  "    pm.expect(body.meta).to.have.property('total').that.is.a('number');",
                  "    pm.expect(body.meta).to.have.property('page').that.eql(1);",
                  "    pm.expect(body.meta).to.have.property('pageSize').that.eql(20);",
                  "    pm.expect(body.meta).to.have.property('totalPages').that.is.a('number');",
                  "});",
                  "",
                  "pm.test('Trip fields are correct', () => {",
                  "    const trips = pm.response.json().data;",
                  "    if (trips.length > 0) {",
                  "        const trip = trips[0];",
                  "        pm.expect(trip).to.have.property('id');",
                  "        pm.expect(trip).to.have.property('bikeId');",
                  "        pm.expect(trip).to.have.property('startTs');",
                  "        pm.expect(trip).to.have.property('durationSec').that.is.a('number');",
                  "        pm.expect(trip).to.have.property('distanceKm').that.is.a('number');",
                  "        pm.expect(trip).to.have.property('score').that.is.a('number');",
                  "    }",
                  "});",
                  "",
                  "pm.test('No raw telemetry/GPS in response (privacy)', () => {",
                  "    const trips = pm.response.json().data;",
                  "    trips.forEach(trip => {",
                  "        pm.expect(trip).to.not.have.property('telemetry');",
                  "        pm.expect(trip).to.not.have.property('points');",
                  "        pm.expect(trip).to.not.have.property('lat');",
                  "        pm.expect(trip).to.not.have.property('lng');",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/partner/bikes/{{demoBikeId}}/trips", "host": ["{{baseUrl}}"], "path": ["partner", "bikes", "{{demoBikeId}}", "trips"] }
          }
