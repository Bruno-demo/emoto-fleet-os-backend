          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{baseUrl}}/partner/oauth/token", "host": ["{{baseUrl}}"], "path": ["partner", "oauth", "token"] }
          }
        },
        {
          "name": "1.6 — Token: no auth header → 401 on protected route",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401 without token', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/partner/fleets/{{demoFleetId}}/weekly-summary", "host": ["{{baseUrl}}"], "path": ["partner", "fleets", "{{demoFleetId}}", "weekly-summary"] }
          }
        }
      ]
    },
    {
      "name": "2 — Weekly Summary",
      "item": [
        {
          "name": "2.1 — Demo Fleet: weekly summary (allowed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Response shape is correct', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.fleetId).to.eql(pm.collectionVariables.get('demoFleetId'));",
                  "    pm.expect(body).to.have.property('from').that.is.a('string');",
                  "    pm.expect(body).to.have.property('to').that.is.a('string');",
                  "    pm.expect(body).to.have.property('tripCount').that.is.a('number');",
                  "    pm.expect(body).to.have.property('eventCount').that.is.a('number');",
                  "    pm.expect(body).to.have.property('incidentCount').that.is.a('number');",
                  "    pm.expect(body).to.have.property('crashCount').that.is.a('number');",
                  "    pm.expect(body).to.have.property('avgScore').that.is.a('number');",
                  "});",
                  "",
                  "pm.test('Counts are non-negative', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.tripCount).to.be.at.least(0);",
                  "    pm.expect(body.eventCount).to.be.at.least(0);",
                  "    pm.expect(body.incidentCount).to.be.at.least(0);",
                  "    pm.expect(body.crashCount).to.be.at.least(0);",
                  "    pm.expect(body.avgScore).to.be.at.least(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/partner/fleets/{{demoFleetId}}/weekly-summary", "host": ["{{baseUrl}}"], "path": ["partner", "fleets", "{{demoFleetId}}", "weekly-summary"] }
          }
