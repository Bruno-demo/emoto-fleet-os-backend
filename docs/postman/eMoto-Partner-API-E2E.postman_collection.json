{
  "info": {
    "name": "eMoto Partner API — E2E Tests",
    "description": "Complete end-to-end test suite for the eMoto Fleet OS Partner API.\n\nRun the collection in order — each folder builds on variables set by previous requests.\n\n**Setup:** Ensure the API is running on `{{baseUrl}}` (default `http://localhost:3000`).\n\n**Seeded credentials:**\n- Partner 1 (Demo Insurer): `partner-demo-client` / `PartnerSecret123!`\n- Partner 2 (Analytics): `partner-analytics-client` / `AnalyticsSecret456!`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "clientId", "value": "partner-demo-client", "type": "string" },
    { "key": "clientSecret", "value": "PartnerSecret123!", "type": "string" },
    { "key": "analyticsClientId", "value": "partner-analytics-client", "type": "string" },
    { "key": "analyticsClientSecret", "value": "AnalyticsSecret456!", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "analyticsToken", "value": "", "type": "string" },
    { "key": "demoFleetId", "value": "00000000-0000-0000-0000-000000000001", "type": "string" },
    { "key": "northFleetId", "value": "00000000-0000-0000-0000-000000000002", "type": "string" },
    { "key": "southFleetId", "value": "00000000-0000-0000-0000-000000000003", "type": "string" },
    { "key": "demoBikeId", "value": "c7fcd771-1284-48be-8da4-2f1ebb913385", "type": "string" },
    { "key": "resolvedIncidentId", "value": "d5f4a79b-df0a-4fb1-82a4-da98875a4f09", "type": "string" },
    { "key": "openIncidentId", "value": "d50836de-9543-49fd-97e3-57cf9f736a69", "type": "string" },
    { "key": "thirdFleetBikeId", "value": "b8e86b3c-31ed-46d8-8524-2e8db534c243", "type": "string" },
    { "key": "webhookId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1 — Authentication",
      "item": [
        {
          "name": "1.1 — Token: valid credentials (Demo Insurer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "",
                  "pm.test('Response has accessToken', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('accessToken').that.is.a('string').and.not.empty;",
                  "    pm.expect(body.tokenType).to.eql('Bearer');",
                  "    pm.expect(body.expiresIn).to.be.a('string');",
                  "    pm.expect(body.scopes).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Scopes include insurer:read and webhooks:write', () => {",
                  "    const scopes = pm.response.json().scopes;",
                  "    pm.expect(scopes).to.include('insurer:read');",
                  "    pm.expect(scopes).to.include('webhooks:write');",
                  "});",
                  "",
                  "// Save token for subsequent requests",
                  "pm.collectionVariables.set('accessToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"clientSecret\": \"{{clientSecret}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/partner/oauth/token", "host": ["{{baseUrl}}"], "path": ["partner", "oauth", "token"] }
          }
        },
        {
          "name": "1.2 — Token: valid credentials (Analytics)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "",
                  "pm.test('Scopes include insurer:read only', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.scopes).to.include('insurer:read');",
                  "    pm.expect(body.scopes).to.not.include('webhooks:write');",
                  "});",
                  "",
                  "pm.collectionVariables.set('analyticsToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{analyticsClientId}}\",\n  \"clientSecret\": \"{{analyticsClientSecret}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/partner/oauth/token", "host": ["{{baseUrl}}"], "path": ["partner", "oauth", "token"] }
          }
