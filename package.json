{
  "name": "emoto-fleet-os-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:stack:up": "docker compose up -d",
    "dev:stack:down": "docker compose down",
    "dev:stack:logs": "docker compose logs -f",
    "dev:api": "npm --prefix apps/api run start:dev",
    "db:generate": "npm --prefix apps/api run db:generate",
    "db:migrate": "npm --prefix apps/api run db:migrate",
    "db:deploy": "npm --prefix apps/api run db:deploy",
    "db:seed": "npm --prefix apps/api run db:seed",
    "db:studio": "npm --prefix apps/api run db:studio",
    "mqtt:publish:sample": "npm --prefix apps/api run mqtt:publish:sample",
    "mqtt:publish:sample:ack": "npm --prefix apps/api run mqtt:publish:sample:ack",
    "lint": "npm --prefix apps/api run lint",
    "format": "npm --prefix apps/api run format"
  }
}
