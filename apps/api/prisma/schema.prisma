generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FleetType {
  COOP
  DELIVERY
}

enum UserRole {
  OWNER
  ADMIN
  DISPATCHER
  TECH
  INSURER
  RIDER
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum BikeStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
  RETIRED
}

enum DeviceCommandType {
  LOCK
  UNLOCK
}

enum DeviceCommandStatus {
  PENDING
  SENT
  ACKED
  FAILED
  EXPIRED
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  FALSE_ALARM
}

enum EmergencyContactRole {
  DISPATCH
  MANAGER
  EMERGENCY
}

enum NotificationType {
  CRASH_ALERT
  THEFT_ALERT
  SOS_ALERT
}

enum NotificationChannel {
  SMS
  EMAIL
  WEBHOOK
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum PartnerStatus {
  ACTIVE
  DISABLED
}

enum PartnerClientStatus {
  ACTIVE
  DISABLED
}

enum EventSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EventType {
  OVERSPEED
  SPEED_LIMIT_VIOLATION
  SCHOOL_ZONE_SPEED
  HOSPITAL_ZONE_SPEED
  MARKET_ZONE_SPEED
  HARSH_BRAKE
  HARSH_ACCEL
  HARSH_CORNER
  CRASH
  THEFT_SUSPECTED
  SOS
}

enum RoadFeatureType {
  SCHOOL
  HOSPITAL
  MARKET
  TRAFFIC_SIGN
  SPEED_LIMIT
}

enum RoadFeatureSource {
  OSM
}

enum RoadFeatureOsmType {
  NODE
  WAY
  RELATION
}

enum ScoreScope {
  RIDER
  BIKE
  FLEET
}

enum ZoneType {
  SLOW
  NO_GO
  PARK
}

enum PoiType {
  GARAGE
  SWAP
  CLINIC
  OTHER
}

enum AuditActionType {
  DEVICE_SECRET_ROTATED
  ZONE_CREATED
  ZONE_UPDATED
  ZONE_DELETED
  LOCK_ACTION_REQUESTED
  DEVICE_COMMAND_REQUESTED
  DEVICE_COMMAND_STATUS_CHANGED
  PARTNER_TOKEN_ISSUED
  PARTNER_API_ACCESS
  PARTNER_WEBHOOK_REGISTERED
  PARTNER_WEBHOOK_DELIVERY
  RIDER_CREATED
  BIKE_ASSIGNMENT_CHANGED
  SOS_TRIGGERED
}

model Fleet {
  id                String               @id @default(uuid()) @db.Uuid
  name              String
  type              FleetType
  createdAt         DateTime             @default(now()) @db.Timestamptz(6)
  users             User[]
  bikes             Bike[]
  devices           Device[]
  events            Event[]
  trips             Trip[]
  scoreSummaries    ScoreSummary[]
  zones             GeofenceZone[]
  auditLogs         AuditLog[]
  commands          DeviceCommand[]
  incidents         Incident[]
  emergencyContacts EmergencyContact[]
  notifications     Notification[]
  partnerAccesses   PartnerFleetAccess[]
  bikeAssignments   BikeAssignment[]
  pois              Poi[]
}

model User {
  id                    String           @id @default(uuid()) @db.Uuid
  fleetId               String           @db.Uuid
  role                  UserRole
  phone                 String?
  email                 String?
  passwordHash          String
  status                UserStatus       @default(ACTIVE)
  createdAt             DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @db.Timestamptz(6)
  fleet                 Fleet            @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  trips                 Trip[]           @relation("TripRider")
  auditLogs             AuditLog[]
  requestedCommands     DeviceCommand[]
  acknowledgedIncidents Incident[]       @relation("IncidentAcknowledgedBy")
  resolvedIncidents     Incident[]       @relation("IncidentResolvedBy")
  riderProfile          RiderProfile?
  bikeAssignments       BikeAssignment[] @relation("BikeAssignmentRider")

  @@unique([fleetId, email])
  @@unique([fleetId, phone])
  @@index([fleetId])
  @@index([fleetId, role])
}

model Bike {
  id          String           @id @default(uuid()) @db.Uuid
  fleetId     String           @db.Uuid
  label       String
  plate       String?
  serial      String?
  model       String?
  status      BikeStatus       @default(ACTIVE)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)
  fleet       Fleet            @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  devices     Device[]
  events      Event[]
  trips       Trip[]
  commands    DeviceCommand[]
  incidents   Incident[]
  assignments BikeAssignment[]

  @@unique([fleetId, label])
  @@unique([fleetId, plate])
  @@unique([serial])
  @@index([fleetId])
  @@index([fleetId, status])
}

model Device {
  id              String           @id @default(uuid()) @db.Uuid
  fleetId         String           @db.Uuid
  imei            String?
  deviceUid       String           @unique
  bikeId          String?          @db.Uuid
  secretHash      String
  secretEncrypted String?
  lastSeenAt      DateTime?        @db.Timestamptz(6)
  fwVersion       String?
  status          DeviceStatus     @default(ACTIVE)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)
  fleet           Fleet            @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  bike            Bike?            @relation(fields: [bikeId], references: [id], onDelete: SetNull)
  telemetry       TelemetryPoint[]
  events          Event[]
  commands        DeviceCommand[]
  incidents       Incident[]

  @@unique([imei])
  @@index([fleetId])
  @@index([fleetId, status])
  @@index([bikeId])
}

model TelemetryPoint {
  id        BigInt   @id @default(autoincrement())
  deviceId  String   @db.Uuid
  ts        DateTime @db.Timestamptz(6)
  lat       Decimal  @db.Decimal(9, 6)
  lng       Decimal  @db.Decimal(9, 6)
  speedKph  Decimal  @db.Decimal(6, 2)
  heading   Decimal? @db.Decimal(6, 2)
  accelX    Decimal? @db.Decimal(8, 4)
  accelY    Decimal? @db.Decimal(8, 4)
  accelZ    Decimal? @db.Decimal(8, 4)
  batteryV  Decimal? @db.Decimal(8, 3)
  ignition  Boolean?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([ts])
  @@index([deviceId, ts])
}

model Event {
  id        BigInt        @id @default(autoincrement())
  fleetId   String        @db.Uuid
  bikeId    String?       @db.Uuid
  deviceId  String        @db.Uuid
  ts        DateTime      @db.Timestamptz(6)
  type      EventType
  severity  EventSeverity
  metaJson  Json
  createdAt DateTime      @default(now()) @db.Timestamptz(6)
  fleet     Fleet         @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  bike      Bike?         @relation(fields: [bikeId], references: [id], onDelete: SetNull)
  device    Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  incident  Incident?

  @@index([fleetId])
  @@index([deviceId])
  @@index([ts])
  @@index([fleetId, ts])
  @@index([deviceId, ts])
}

model RiderProfile {
  userId    String   @id @db.Uuid
  fullName  String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BikeAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  fleetId      String    @db.Uuid
  bikeId       String    @db.Uuid
  riderUserId  String    @db.Uuid
  assignedAt   DateTime  @default(now()) @db.Timestamptz(6)
  unassignedAt DateTime? @db.Timestamptz(6)
  active       Boolean   @default(true)
  fleet        Fleet     @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  bike         Bike      @relation(fields: [bikeId], references: [id], onDelete: Cascade)
  rider        User      @relation("BikeAssignmentRider", fields: [riderUserId], references: [id], onDelete: Cascade)

  @@index([fleetId])
  @@index([bikeId])
  @@index([riderUserId])
  @@index([active])
  @@index([fleetId, active])
}

model Poi {
  id        String   @id @default(uuid()) @db.Uuid
  fleetId   String?  @db.Uuid
  type      PoiType
  name      String
  phone     String?
  lat       Decimal  @db.Decimal(9, 6)
  lng       Decimal  @db.Decimal(9, 6)
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  fleet     Fleet?   @relation(fields: [fleetId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([fleetId])
  @@index([active])
  @@index([fleetId, active])
}

model Trip {
  id          String    @id @default(uuid()) @db.Uuid
  fleetId     String    @db.Uuid
  bikeId      String    @db.Uuid
  riderId     String?   @db.Uuid
  startTs     DateTime  @db.Timestamptz(6)
  endTs       DateTime? @db.Timestamptz(6)
  distanceKm  Decimal   @db.Decimal(10, 3)
  durationSec Int
  score       Decimal   @db.Decimal(5, 2)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  fleet       Fleet     @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  bike        Bike      @relation(fields: [bikeId], references: [id], onDelete: Cascade)
  rider       User?     @relation("TripRider", fields: [riderId], references: [id], onDelete: SetNull)

  @@index([fleetId])
  @@index([bikeId])
  @@index([startTs])
  @@index([fleetId, startTs])
  @@index([bikeId, startTs])
}

model ScoreSummary {
  id            String     @id @default(uuid()) @db.Uuid
  fleetId       String     @db.Uuid
  scope         ScoreScope
  refId         String?    @db.Uuid
  periodStart   DateTime   @db.Timestamptz(6)
  periodEnd     DateTime   @db.Timestamptz(6)
  score         Decimal    @db.Decimal(5, 2)
  breakdownJson Json
  createdAt     DateTime   @default(now()) @db.Timestamptz(6)
  fleet         Fleet      @relation(fields: [fleetId], references: [id], onDelete: Cascade)

  @@index([fleetId])
  @@index([scope, refId])
  @@index([periodStart, periodEnd])
  @@index([fleetId, scope, periodStart, periodEnd])
}

model GeofenceZone {
  id             String   @id @default(uuid()) @db.Uuid
  fleetId        String   @db.Uuid
  name           String
  type           ZoneType
  geojsonPolygon Json
  speedLimitKph  Decimal? @db.Decimal(6, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)
  fleet          Fleet    @relation(fields: [fleetId], references: [id], onDelete: Cascade)

  @@index([fleetId])
  @@index([fleetId, active, type])
}

model RoadFeature {
  id            String             @id @default(uuid()) @db.Uuid
  source        RoadFeatureSource  @default(OSM)
  osmId         String
  osmType       RoadFeatureOsmType
  type          RoadFeatureType
  name          String?
  speedLimitKph Int?
  lat           Decimal            @db.Decimal(9, 6)
  lng           Decimal            @db.Decimal(9, 6)
  tagsJson      Json?
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(6)

  @@unique([source, osmId, osmType])
  @@index([type])
  @@index([lat, lng])
}

model AuditLog {
  id          BigInt          @id @default(autoincrement())
  fleetId     String          @db.Uuid
  actorUserId String?         @db.Uuid
  actionType  AuditActionType
  targetType  String
  targetId    String?
  metaJson    Json
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  fleet       Fleet           @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  actorUser   User?           @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([fleetId, createdAt])
  @@index([actorUserId])
  @@index([actionType])
}

model DeviceCommand {
  id                String              @id @default(uuid()) @db.Uuid
  fleetId           String              @db.Uuid
  deviceId          String              @db.Uuid
  bikeId            String?             @db.Uuid
  type              DeviceCommandType
  status            DeviceCommandStatus @default(PENDING)
  requestedByUserId String              @db.Uuid
  requestedAt       DateTime            @default(now()) @db.Timestamptz(6)
  sentAt            DateTime?           @db.Timestamptz(6)
  ackedAt           DateTime?           @db.Timestamptz(6)
  payloadJson       Json
  errorMessage      String?
  nonce             String              @db.Uuid
  expiresAt         DateTime            @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(6)
  fleet             Fleet               @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  device            Device              @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  bike              Bike?               @relation(fields: [bikeId], references: [id], onDelete: SetNull)
  requestedByUser   User                @relation(fields: [requestedByUserId], references: [id])

  @@index([fleetId])
  @@index([deviceId])
  @@index([requestedAt])
  @@index([status])
}

model Incident {
  id                   String         @id @default(uuid()) @db.Uuid
  fleetId              String         @db.Uuid
  bikeId               String?        @db.Uuid
  deviceId             String         @db.Uuid
  eventId              BigInt         @unique
  status               IncidentStatus @default(OPEN)
  createdAt            DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @db.Timestamptz(6)
  acknowledgedByUserId String?        @db.Uuid
  acknowledgedAt       DateTime?      @db.Timestamptz(6)
  resolvedByUserId     String?        @db.Uuid
  resolvedAt           DateTime?      @db.Timestamptz(6)
  notes                String?
  fleet                Fleet          @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  bike                 Bike?          @relation(fields: [bikeId], references: [id], onDelete: SetNull)
  device               Device         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  event                Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  acknowledgedByUser   User?          @relation("IncidentAcknowledgedBy", fields: [acknowledgedByUserId], references: [id], onDelete: SetNull)
  resolvedByUser       User?          @relation("IncidentResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  evidencePack         EvidencePack?

  @@index([fleetId, status, createdAt])
  @@index([bikeId])
  @@index([deviceId])
}

model EvidencePack {
  id         String   @id @default(uuid()) @db.Uuid
  incidentId String   @unique @db.Uuid
  s3KeyJson  String
  s3KeyCsv   String
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model EmergencyContact {
  id        String               @id @default(uuid()) @db.Uuid
  fleetId   String               @db.Uuid
  name      String
  phone     String
  role      EmergencyContactRole
  active    Boolean              @default(true)
  createdAt DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt DateTime             @updatedAt @db.Timestamptz(6)
  fleet     Fleet                @relation(fields: [fleetId], references: [id], onDelete: Cascade)

  @@index([fleetId])
  @@index([fleetId, active, role])
}

model Notification {
  id               String              @id @default(uuid()) @db.Uuid
  fleetId          String              @db.Uuid
  type             NotificationType
  channel          NotificationChannel
  to               String
  payloadJson      Json
  status           NotificationStatus  @default(PENDING)
  attemptCount     Int                 @default(0)
  partnerWebhookId String?             @db.Uuid
  errorMessage     String?
  createdAt        DateTime            @default(now()) @db.Timestamptz(6)
  sentAt           DateTime?           @db.Timestamptz(6)
  fleet            Fleet               @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  partnerWebhook   PartnerWebhook?     @relation(fields: [partnerWebhookId], references: [id], onDelete: SetNull)

  @@index([fleetId])
  @@index([status])
  @@index([createdAt])
  @@index([partnerWebhookId])
}

model Partner {
  id            String               @id @default(uuid()) @db.Uuid
  name          String
  status        PartnerStatus        @default(ACTIVE)
  createdAt     DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(6)
  clients       PartnerClient[]
  fleetAccesses PartnerFleetAccess[]
  webhooks      PartnerWebhook[]

  @@index([status])
}

model PartnerClient {
  id               String              @id @default(uuid()) @db.Uuid
  partnerId        String              @db.Uuid
  clientId         String              @unique
  clientSecretHash String
  scopes           String
  status           PartnerClientStatus @default(ACTIVE)
  createdAt        DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(6)
  partner          Partner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([status])
  @@index([partnerId, status])
}

model PartnerFleetAccess {
  id        String   @id @default(uuid()) @db.Uuid
  partnerId String   @db.Uuid
  fleetId   String   @db.Uuid
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  fleet     Fleet    @relation(fields: [fleetId], references: [id], onDelete: Cascade)

  @@unique([partnerId, fleetId])
  @@index([partnerId, active])
  @@index([fleetId, active])
}

model PartnerWebhook {
  id              String         @id @default(uuid()) @db.Uuid
  partnerId       String         @db.Uuid
  url             String
  secretHash      String
  secretEncrypted String?
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(6)
  partner         Partner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  notifications   Notification[]

  @@index([partnerId])
  @@index([partnerId, active])
}
