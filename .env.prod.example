NODE_ENV=production
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=0
API_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001,http://localhost:8082
GATEWAY_PORT=8080
GATEWAY_API_URL=http://api:3000
GATEWAY_CORS_ORIGIN=http://localhost:3001
GATEWAY_RATE_WINDOW_MS=60000
GATEWAY_RATE_LIMIT_LOGIN=10
GATEWAY_RATE_LIMIT_REGISTER=5
GATEWAY_RATE_LIMIT_PARTNER=10

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=emoto_fleet
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/emoto_fleet

REDIS_URL=redis://redis:6379
REDIS_IN_MEMORY=false
STREAM_REDIS_URL=redis://redis:6379
STREAM_KEY=telemetry:stream
STREAM_GROUP=telemetry-processors
STREAM_POLL_MS=1000
STREAM_MAX_LEN=10000
STREAM_ENRICHED_KEY=telemetry:enriched
STREAM_SCORE_KEY=telemetry:score
STREAM_WEBHOOK_KEY=webhooks:outbox
STREAM_OUTPUT_MAX_LEN=10000
STREAM_ENABLED=true

MQTT_URL=mqtt://emqx:1883
MQTT_DISABLED=false
MQTT_SAMPLE_DEVICE_UID=DEV-0001
MQTT_SAMPLE_DEVICE_SECRET=device-secret-0001
MQTT_SAMPLE_COMMAND_ID=00000000-0000-0000-0000-000000000000
MQTT_SAMPLE_ACK_STATUS=ACKED
MQTT_SAMPLE_ACK_ERROR_MESSAGE=Simulated device failure

OVERPASS_API_URL=https://overpass-api.de/api/interpreter
ROAD_FEATURE_CACHE_TTL_SECONDS=3600
ROAD_FEATURE_REFRESH_SECONDS=86400
ROAD_FEATURE_MAX_RESULTS=600
ROAD_SPEED_LIMIT_RADIUS_METERS=80
ROAD_SAFETY_RADIUS_METERS=200
ROAD_SPEED_TOLERANCE_KPH=5
ROAD_SCHOOL_SPEED_KPH=30
ROAD_HOSPITAL_SPEED_KPH=30
ROAD_MARKET_SPEED_KPH=25

EMQX_DASHBOARD_PORT=18083
EMQX_DASHBOARD_USERNAME=admin
EMQX_DASHBOARD_PASSWORD=public

MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=emoto-evidence
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRES_SECONDS=600

DEVICE_SECRET_MASTER_KEY=change_me_device_secret_master_key_32chars
COMMAND_TTL_SECONDS=45
INCIDENT_CRASH_MIN_SEVERITY=HIGH
JWT_SECRET=change_me_change_me
JWT_EXPIRES_IN=1h
PARTNER_JWT_SECRET=change_me_partner_jwt_secret
PARTNER_JWT_EXPIRES_IN=1h
PARTNER_WEBHOOK_SECRET_MASTER_KEY=change_me_partner_webhook_secret_master_key_32chars
AUTH_REGISTER_ENABLED=false
AUTH_PUBLIC_REGISTER_ENABLED=false
INVITE_TOKEN_TTL_HOURS=168
BCRYPT_SALT_ROUNDS=10
NOTIFICATION_OUTBOX_INLINE=false

TRIP_SCORE_MIN_DISTANCE_KM=1
TRIP_SCORE_PENALTY_MULTIPLIER=20
TRIP_SCORE_WEIGHT_OVERSPEED=1.2
TRIP_SCORE_WEIGHT_SPEED_LIMIT=1.1
TRIP_SCORE_WEIGHT_SCHOOL_ZONE=1.4
TRIP_SCORE_WEIGHT_HOSPITAL_ZONE=1.2
TRIP_SCORE_WEIGHT_MARKET_ZONE=1.2
TRIP_SCORE_WEIGHT_HARSH_BRAKE=1
TRIP_SCORE_WEIGHT_HARSH_ACCEL=0.8
TRIP_SCORE_WEIGHT_HARSH_CORNER=0.8
TRIP_SCORE_WEIGHT_CRASH=4
TRIP_SCORE_WEIGHT_THEFT_SUSPECTED=3

LOG_LEVEL=info
LOG_PRETTY=false

RUN_MIGRATIONS=true

BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
BACKUP_DIR=/backups

PROMETHEUS_PORT=9090
GRAFANA_PORT=3005
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
